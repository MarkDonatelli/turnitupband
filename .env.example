# Server-only Netlify Function variables. Never use NUXT_PUBLIC_ for these.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PEM key in Netlify. Literal \n line breaks are also supported.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional: true for synthetic calendar data in netlify dev only.
# npm run dev:mock sets this automatically; deployed functions ignore it.
CALENDAR_MOCK=false
